{
  "$description": "/* ============================================================================\n * 브랜드 — Mobility · 모빌리티 서비스 (가상 산업 브랜드 · TD-125)  ← 공개용 데모 브랜드\n * 사용자: 수요응답 교통(DRT) 이용자 — 고령층 포함\n *\n * 선택자: :root.theme-mobility  →  <html class=\"theme-mobility\">\n * 멀티 브랜드가 \"브랜드 파일 하나 + html 클래스 하나\"로 바뀌는 것을 보여주는 가상 브랜드.\n * 이 파일이 여는 토큰 = 색 + 모서리 역할 + 그림 자산 모양 (DS-ADR-003 · 020 · 037, 목록은 _template.css). 높이 · 글자 크기는 고령 이용자 기준 범위의 하한을 임시로(컨트롤 44 · 큰 버튼 56 · 누름 기준 44 · 본문 16, TD-172 · DS-ADR-049) — 최종 값은 TD-145 시안 뒤.\n * 형태: 둥근 모서리 — 버튼 · 칩 알약, 입력칸 · 카드 · 영역 · 떠 있는 층 8, 체크박스 · 행 · 스켈레톤 4.\n *   반대쪽 끝은 ootb.css(직각 · 높이 32).\n * 그림 자산: 라인 — 빈 상태 일러스트 · 폴더 · 파일 형식 아이콘을 선 모양으로 (DS-ADR-037)\n * 대비 (바이올렛 기준 — 색을 바꾸면 다시 잰다): 500/흰 5.75 · 600/흰 7.51 · 800/흰 11.74 · 다크 300 글자 5.62\n * ============================================================================ */",
  "$extensions": {
    "eds": {
      "selector": ":root.theme-mobility"
    }
  },
  "brand-50": {
    "$value": "#F3F0FE",
    "$type": "color"
  },
  "brand-100": {
    "$value": "#E4DCFD",
    "$type": "color"
  },
  "brand-200": {
    "$value": "#C9B9FA",
    "$type": "color"
  },
  "brand-300": {
    "$value": "#A68CF5",
    "$type": "color"
  },
  "brand-400": {
    "$value": "#8B6CEE",
    "$type": "color"
  },
  "brand-500": {
    "$value": "#6D4ADB",
    "$type": "color"
  },
  "brand-600": {
    "$value": "#5A38C4",
    "$type": "color"
  },
  "brand-700": {
    "$value": "#47299F",
    "$type": "color"
  },
  "brand-800": {
    "$value": "#3B2585",
    "$type": "color"
  },
  "brand-900": {
    "$value": "#261754",
    "$type": "color"
  },
  "accent-500": {
    "$value": "#F2A93B",
    "$type": "color"
  },
  "radius-btn": {
    "$value": "{radius-rounded}",
    "$extensions": {
      "eds": {
        "before": [
          "/* --- 형태 (모서리 역할 → 단계, DS-ADR-020) ------------------------------- */"
        ]
      }
    }
  },
  "radius-input": {
    "$value": "{radius-lg}"
  },
  "radius-checkbox": {
    "$value": "{radius-md}"
  },
  "radius-chip": {
    "$value": "{radius-rounded}"
  },
  "radius-item": {
    "$value": "{radius-md}"
  },
  "radius-card": {
    "$value": "{radius-lg}"
  },
  "radius-panel": {
    "$value": "{radius-lg}"
  },
  "radius-popover": {
    "$value": "{radius-lg}"
  },
  "radius-skeleton": {
    "$value": "{radius-md}"
  },
  "size-input": {
    "$value": "44px",
    "$extensions": {
      "eds": {
        "before": [
          "/* --- 높이 (DS-ADR-020 · 049) — 고령 이용자 기준 범위의 하한(컨트롤 44–48 · 큰 버튼 56–88), 최종 값은 TD-145 ---------- */"
        ]
      }
    }
  },
  "size-btn": {
    "$value": "44px"
  },
  "size-btn-lg": {
    "$value": "56px"
  },
  "size-touch": {
    "$value": "44px"
  },
  "body-lg": {
    "$value": "1.125rem",
    "$extensions": {
      "eds": {
        "before": [
          "/* --- 글자 크기 (DS-ADR-046) — 본문 16–18 범위의 하한, 단계 순서 유지. 최종 값은 TD-145 ---------- */"
        ]
      }
    }
  },
  "body-md": {
    "$value": "1rem"
  },
  "body-sm": {
    "$value": "0.875rem"
  },
  "body-xs": {
    "$value": "0.8125rem"
  },
  "heading-2xl": {
    "$value": "2.5rem"
  },
  "heading-xl": {
    "$value": "2rem"
  },
  "heading-lg": {
    "$value": "1.75rem"
  },
  "heading-md": {
    "$value": "1.5rem"
  },
  "heading-sm": {
    "$value": "1.25rem"
  },
  "heading-xs": {
    "$value": "1rem"
  },
  "font-weight-emphasis": {
    "$value": "{font-weight-bold}",
    "$extensions": {
      "eds": {
        "before": [
          "/* --- 강조 굵기 (DS-ADR-049) — 주 행동 · 제목 700, 고령 이용자 기준(굵기 700 이상) ---------- */"
        ]
      }
    }
  },
  "art-solid": {
    "$value": "none",
    "$extensions": {
      "eds": {
        "before": [
          "/* --- 그림 자산 (DS-ADR-037) — 하나만 block -------------------------------- */"
        ]
      }
    }
  },
  "art-line": {
    "$value": "block"
  }
}
